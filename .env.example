# Скопируй в .env и заполни. Сам .env в git НЕ коммитить!

# Сервисный ключ приложения VK (vk.com/apps?act=manage → приложение → Настройки)
VK_SERVICE_TOKEN=

# Короткое имя паблика из ссылки (vk.com/spp_polytech → spp_polytech) или id со знаком минус (-12345)
VK_GROUP=spp_polytech

# Как часто обновлять новости (форматы: 30m, 1h, 3h)
REFRESH_INTERVAL=1h
# Через сколько повторить, если VK не ответил
RETRY_INTERVAL=5m

PORT=8080
VK_API_VERSION=5.199
VK_POSTS_COUNT=100

# Адрес фронта, если он на другом домене/порту (например http://localhost:3003). Иначе оставить пустым.
CORS_ORIGIN=
