VK_SERVICE_TOKEN=
VK_GROUP=spp_polytech

REFRESH_INTERVAL=1h
RETRY_INTERVAL=5m

PORT=8080
VK_API_VERSION=5.199
VK_POSTS_COUNT=100

# Адрес фронта, если он на другом домене/порту (например http://localhost:3003). Иначе оставить пустым.
CORS_ORIGIN=

# Для локального запуска (go run .); в Docker их задаёт docker-compose.yaml.
# Файл, куда дублировать логи (кроме stdout). Пусто — только stdout.
LOG_FILE=
# Файл, где будут храниться новости
STORE_FILE=store/news.json
